# ── Local dev container config (docker-compose.local.yml) ──
# Host UID/GID the dev containers run as, so bind-mounted files stay owned by
# you (not root). The justfile injects these automatically from `id -u`/`id -g`;
# you normally do NOT need to set them by hand. Override only if your login
# shell makes `id -u` unavailable.
HOST_UID=1000
HOST_GID=1000

# If ports are taken by another project, override any of these (defaults shown).
# Caddy, the local edge, binds port 80 (http://*.etqan.localhost) unless
# ETQAN_HTTP_PORT says otherwise; scripts/orchestration/stream-env.sh writes a
# whole set into .env.stream for a parallel phase worktree.
# ETQAN_HTTP_PORT=80
# ETQAN_PG_PORT=5432
# ETQAN_REDIS_PORT=6379
# ETQAN_API_PORT=8000
# ETQAN_FLOWER_PORT=5555
# ETQAN_MAIL_UI_PORT=8025
# ETQAN_SMTP_PORT=1025

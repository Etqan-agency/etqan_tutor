+
+WEAK = ["12345678", "password", "u@example.com", "x" * 129]
+
+
+@pytest.mark.django_db
+class TestNewPasswordsAreValidated:
+    """ETQAN-QA-018: change and reset-by-link take the same password rules as
+    reset-by-code and account creation (`AUTH_PASSWORD_VALIDATORS`, at most
+    128 characters); a refused password changes nothing."""
+
+    @pytest.mark.parametrize("weak", WEAK)
+    def test_change_refuses_a_weak_password(self, api, weak):
+        user = _user()
+        api.force_authenticate(user=user)
+        resp = api.post(
+            "/api/v1/identity/me/password/",
+            {"current_password": "old-secret-pw", "new_password": weak},
+            format="json",
+        )
+        assert resp.status_code == 400, resp.data
+        assert "new_password" in resp.data
+        user.refresh_from_db()
+        assert user.check_password("old-secret-pw")
+
+    @pytest.mark.parametrize("weak", WEAK)
+    def test_reset_by_link_refuses_a_weak_password(self, api, weak):
+        user = _verified_user()
+        resp = api.post(
+            "/api/v1/identity/password/reset/confirm/",
+            {
+                "uid": urlsafe_base64_encode(force_bytes(user.pk)),
+                "token": default_token_generator.make_token(user),
+                "new_password": weak,
+            },
+            format="json",
+        )
+        assert resp.status_code == 400, resp.data
+        assert "new_password" in resp.data
+        user.refresh_from_db()
+        assert user.check_password("old-secret-pw")

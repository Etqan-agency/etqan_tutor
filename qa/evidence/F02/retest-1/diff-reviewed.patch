+session whose impersonator no longer passes S-9a's re-checks.
+
+Signed out for good (ETQAN-QA-017): the view runs inside the request's
+transaction (``ATOMIC_REQUESTS``), and the 403 it then answers rolls that
+back, the session row's delete with it. So the refused session's key is kept
+on the request, and `EndRefusedSessionMiddleware` deletes the row again once
+the transaction is over."""
 
 from django.contrib.auth import logout
 from rest_framework import authentication
@@ -9,6 +15,8 @@ from rest_framework import authentication
 from etqan.identity import impersonation
 from etqan.identity import services
 
+REFUSED_SESSION_KEY = "etqan_refused_session_key"
+
 
 class SessionAuthentication(authentication.SessionAuthentication):
     def authenticate(self, request):
@@ -18,6 +26,25 @@ class SessionAuthentication(authentication.SessionAuthentication):
             or not impersonation.session_valid(request)
         ):
             # The Django request holds the session; DRF's wraps it.
-            logout(request._request)  # noqa: SLF001
+            django_request = request._request  # noqa: SLF001
+            setattr(
+                django_request, REFUSED_SESSION_KEY, django_request.session.session_key
+            )
+            logout(django_request)
             return None
         return result
+
+
+class EndRefusedSessionMiddleware:
+    """Delete the session `SessionAuthentication` refused, after the view's
+    transaction: a rolled-back request would otherwise bring it back."""
+
+    def __init__(self, get_response):
+        self.get_response = get_response
+
+    def __call__(self, request):
+        response = self.get_response(request)
+        key = getattr(request, REFUSED_SESSION_KEY, None)
+        if key:
+            request.session.delete(key)
+        return response

+def test_a_refused_session_does_not_come_back(api_for, set_features):
+    """ETQAN-QA-017: the 403 rolled the request back, the session row's
+    delete with it, so the old cookie signed in again once switched on."""
+    admin = api_for("admin")
+    sign_in_as(admin, person(api_for))
+    key = admin.cookies["sessionid"].value
+    set_features(quick_login=False)
+    _logged_out(admin)
+    assert not Session.objects.filter(pk=key).exists()
+    set_features(quick_login=True)
+    admin.cookies["sessionid"] = key
+    assert admin.get(ME).status_code == 403

+    def test_staff_retire_a_role_only_if_they_hold_all_its_codes(self):
+        # ETQAN-QA-021: retiring strips every member of the role's codes, so a
+        # weaker editor must not retire a stronger role (the removal rule).
+        sara = user()
+        role("Mine", "role.update", members=[sara])
+        mo = user(name="Mo")
+        theirs = role("Theirs", "invoice.view_any", members=[mo])
+        message = refused(
+            ForbiddenError,
+            "is_active",
+            services.update_role,
+            theirs,
+            fields={"is_active": False},
+            by=sara,
+        )
+        assert (
+            message == "You can only retire a role whose permissions you hold yourself."
+        )
+        assert services.get_role(theirs.pk).is_active
+        assert "invoice.view_any" in codes_of(mo)
+
+    def test_staff_retire_a_role_whose_codes_they_hold(self):
+        sara = user()
+        role("Mine", "role.update", "payslip.view", members=[sara])
+        theirs = role("Theirs", "payslip.view")
+        services.update_role(theirs, fields={"is_active": False}, by=sara)
+        assert not services.get_role(theirs.pk).is_active
+
+    def test_a_no_op_active_flag_is_not_a_retire(self):
+        sara = user()
+        role("Mine", "role.update", members=[sara])
+        theirs = role("Theirs", "payslip.view")
+        services.update_role(theirs, fields={"is_active": True}, by=sara)
+        assert services.get_role(theirs.pk).is_active
+
+    def test_admins_retire_any_role(self):
+        boss = user("admin", "Boss")
+        theirs = role("Theirs", "payslip.view")
+        services.update_role(theirs, fields={"is_active": False}, by=boss)
+        assert not services.get_role(theirs.pk).is_active
+
     def test_admins_restore_any_role(self):
         boss = user("admin", "Boss")
         theirs = role("Theirs", "payslip.view", active=False)
diff --git a/docs/features/roles-permissions.md b/docs/features/roles-permissions.md
index 86fd5ff5..098237d9 100644
--- a/docs/features/roles-permissions.md
+++ b/docs/features/roles-permissions.md
@@ -46,7 +46,7 @@ Etqan staff (public-schema `is_staff` users) aren't part of this system. They on
 **Anti-escalation rules for staff editors** (`access/services.py`). These apply only when `by` is a staff account; admins are never limited.
 
 1. In a role's codes, staff can add **and remove** only codes they hold themselves.
-2. Staff can restore a retired role only if they hold every code it grants.
+2. Staff can retire or restore a role only if they hold every code it grants: retiring removes all of its codes from every member at once (ETQAN-QA-021). Renaming is not limited: it changes no one's access.
 3. Staff can grant or remove a role only if they hold all of its codes. For removal, retired roles count too (`_roles_to_assign`, `_guard_removed_roles`).
 4. Staff can change another staff account's email or active state only if they outrank it: they must hold every code that account's roles grant, retired roles included (`_guard_stronger_account`).
 5. Staff can never change their own roles or deactivate themselves.

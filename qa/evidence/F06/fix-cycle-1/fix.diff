+def subscription_conflicts(subscription: Subscription) -> list[tuple[Session, Session]]:
+    """ETQAN-QA-042: the double-bookings of ``subscription``'s sessions, for
+    the create and renew answers (P4-9: reported, never blocked)."""
+    return conflicts(
+        list(
+            rules.sessions_queryset()
+            .filter(subscription=subscription)
+            .exclude(status=Session.Status.CANCELLED)
+        )
+    )

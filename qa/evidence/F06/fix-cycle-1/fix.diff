index 29802d09..0e66b036 100644
--- a/etqan/scheduling/services/rules.py
+++ b/etqan/scheduling/services/rules.py
@@ -258,6 +258,19 @@ def covering_substitution(
     return None
 
 
+def person_inactive(subscription: Subscription, day: date) -> bool:
+    """ETQAN-QA-040: the student, or the teacher of ``day`` (the
+    substitute's inside a substitution, G-5), is deactivated. Create, renew
+    and a hand-added session already refuse them; generation and the Today
+    board's missing rows leave them out too. Reads the (prefetched)
+    substitutions and the people's users."""
+    if not subscription.student.user.is_active:
+        return True
+    cover = covering_substitution(subscription, day)
+    teacher = cover.teacher if cover is not None else subscription.teacher
+    return not teacher.user.is_active
+
+
 def covering_pause(subscription: Subscription, day: date) -> SubscriptionPause | None:
     """The pause that includes ``day``. Reads the (prefetched) pauses."""
     for pause in subscription.pauses.all():

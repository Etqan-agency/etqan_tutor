+@pytest.mark.parametrize("write", ["mark_paid", "pay_to_balance"])
+def test_a_payslip_is_not_paid_before_the_month_it_pays(
+    issued_slip, admin, salary_on, write
+):
+    # ETQAN-QA-029: a June payslip paid on 31 May (or in January) would book
+    # its salary expense into an earlier period. The month's first day is fine.
+    pay = getattr(services, write)
+    for early in (date(2026, 5, 31), date(2026, 1, 1)):
+        with pytest.raises(ValidationError) as exc:
+            pay(issued_slip, paid_on=early, by=admin)
+        assert exc.value.field == "paid_on"
+    issued_slip.refresh_from_db()
+    assert (issued_slip.status, issued_slip.paid_on) == ("issued", None)
+    assert posted() == []
+    pay(issued_slip, paid_on=date(2026, 6, 1), by=admin)
+    assert [e.spent_on for e in posted()] == [date(2026, 6, 1)]
+

 def test_public_mail_has_no_reply_to():
     connection.set_schema_to_public()
     assert brand_email(subject="Hello", body="Body")["reply_to"] == []
+
+
+@pytest.mark.django_db
+def test_an_academy_named_alike_in_both_languages_is_named_once(branded):
+    """ETQAN-QA-051: "Etqan QA Academy · Etqan QA Academy" in header and footer."""
+    Branding.objects.update(name_en="Etqan QA Academy", name_ar="Etqan QA Academy")
+    out = brand_email(subject="s", body="b")
+    assert "Etqan QA Academy · Etqan QA Academy" not in out["body"]
+    assert out["body"].count("Etqan QA Academy") == 2  # header + footer
+    assert out["html"].count("Etqan QA Academy") == 2
+    assert "·" not in out["html"].split("</strong>")[1].split("</td>")[0]
+
+
+@pytest.mark.django_db
+def test_two_names_are_both_shown(branded):
+    out = brand_email(subject="s", body="b")
+    assert out["body"].count("Noor Academy · أكاديمية نور") == 2

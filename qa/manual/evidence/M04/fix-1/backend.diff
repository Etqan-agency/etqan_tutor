"""Arabic-aware text search (ETQAN-QA-151).

People type Arabic names without hamza or with the other spelling of a
letter ("ابراهيم" for "إبراهيم", "اسامه" for "أسامة"). A plain
``icontains`` misses those, so a search folds both sides the same way:
alef forms to bare alef, taa marbuta to haa, alef maqsura to yaa, and drops
tatweel and short-vowel marks. No stored column or migration: the folding
runs in the query (``TRANSLATE`` + ``REGEXP_REPLACE``), like ``icontains``
already scans the column.
"""

import re

from django.db.models import Func
from django.db.models import Q
from django.db.models import TextField
from django.db.models import Value

_FROM = "أإآٱةى"
_TO = "ااااهي"
# Tatweel, the harakat (fathatan … sukun) and the superscript alef.
_MARKS = "ـً-ْٰ"
_MARKS_RE = re.compile(f"[{_MARKS}]")
_TABLE = str.maketrans(_FROM, _TO)


def fold(text: str) -> str:
    """The search form of ``text``: Arabic letter variants folded, marks
    dropped. Latin text is unchanged (case is left to ``icontains``)."""
    return _MARKS_RE.sub("", text).translate(_TABLE)


def folded(field: str) -> Func:
    """The database twin of :func:`fold` for a text column."""
    stripped = Func(
        field,
        Value(f"[{_MARKS}]"),
        Value(""),
        Value("g"),
        function="REGEXP_REPLACE",
        output_field=TextField(),
    )
    return Func(
        stripped,
        Value(_FROM),
        Value(_TO),
        function="TRANSLATE",
        output_field=TextField(),
    )


def with_folded(queryset, *fields: str):
    """``queryset`` with each field's folded form aliased (not selected), so
    :func:`folded_q` can match it."""
    return queryset.alias(**{_alias(field): folded(field) for field in fields})


def folded_q(field: str, text: str) -> Q:
    """``field`` contains ``text``, both folded (needs :func:`with_folded`
    on the queryset first)."""
    return Q(**{f"{_alias(field)}__icontains": fold(text)})


def _alias(field: str) -> str:
    return f"_folded_{field.replace('__', '_')}"
from etqan.platform.search import fold


def test_fold_unifies_arabic_letter_variants():
    """ETQAN-QA-151: the spellings people type fold to one form."""
    assert fold("إبراهيم") == fold("ابراهيم") == fold("أبراهيم") == "ابراهيم"
    assert fold("آمنة") == "امنه"
    assert fold("مصطفى") == "مصطفي"
    assert fold("محمّد") == fold("مـحـمد") == "محمد"


def test_fold_leaves_latin_text_alone():
    assert fold("Ibrahim Hassan +20") == "Ibrahim Hassan +20"

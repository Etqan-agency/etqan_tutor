import { describe, expect, it } from "vitest";
import arNotifications from "./ar/notifications.json";
import arPeople from "./ar/people.json";
import enNotifications from "./en/notifications.json";

describe("M04 people copy", () => {
	// ETQAN-QA-169: the admins page invites an admin ("مدير"), not a
	// supervisor ("مشرف", a staff role of its own).
	it("calls an admin an admin in Arabic", () => {
		expect(arPeople.admins.invite).toBe("دعوة مدير");
		expect(arPeople.admins.inviteBody).toContain("مدير");
		expect(JSON.stringify(arPeople.admins)).not.toContain("مشرف");
		expect(arPeople.account.blocked.last_admin).not.toContain("مشرف");
	});

	// ETQAN-QA-155: the hints suit an admin editing someone else's
	// settings, and the Arabic is correct.
	it("keeps the notification hints neutral and correct", () => {
		const hint = arNotifications.preferences.hint;
		expect(hint.schedule).not.toContain("جدولك");
		expect(hint.payments).not.toContain("القاربة");
		expect(hint.payments).toContain("التي قاربت على الانتهاء");
		expect(enNotifications.preferences.hint.schedule).not.toMatch(/your/i);
	});
});

import { render } from "@testing-library/react";
import { afterEach, describe, expect, it } from "vitest";
import i18n from "@/lib/i18n";
import { NameList } from "./NameList";

describe("NameList", () => {
	afterEach(async () => {
		await i18n.changeLanguage("en");
	});

	// ETQAN-QA-170: each name isolated, the Arabic comma in Arabic.
	it("isolates each name and uses the reader's comma", async () => {
		await i18n.changeLanguage("ar");
		const { container } = render(
			<NameList names={["M04 Adam Brooks", "سارة العتيبي"]} />,
		);
		expect(container.textContent).toBe("M04 Adam Brooks، سارة العتيبي");
		expect(
			[...container.querySelectorAll("bdi")].map((b) => b.textContent),
		).toEqual(["M04 Adam Brooks", "سارة العتيبي"]);
	});

	it("uses a Latin comma in English and a dash for none", async () => {
		await i18n.changeLanguage("en");
		const { container, rerender } = render(<NameList names={["A", "B"]} />);
		expect(container.textContent).toBe("A, B");
		rerender(<NameList names={[]} />);
		expect(container.textContent).toBe("—");
	});
});
+++ new src/lib/server-messages.ts
/** The i18n keys for fixed English sentences the server sends without a
 * rule code (a field error from `ValidationError(message, field=…)`), so an
 * Arabic screen doesn't show ".This email is already in use"
 * (ETQAN-QA-157). The backend has no translations of its own yet; a code on
 * these errors is proposed in qa/coverage-gaps.md. Add a sentence here only
 * when it is fixed text (no names or numbers inside). */
const SERVER_MESSAGES: Record<string, string> = {
	"This email is already in use.": "errors.server.emailInUse",
	"This type of file is not allowed.": "errors.server.fileTypeNotAllowed",
};

/** The i18n key for a known server sentence, else `undefined`. */
export function serverMessageKey(message: string): string | undefined {
	return SERVER_MESSAGES[message.trim()];
}

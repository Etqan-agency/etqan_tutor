import { Fragment } from "react";
import { useTranslation } from "react-i18next";
import { type Locale, RTL_LOCALES } from "@/lib/i18n";

/** Names (people, courses) in one line, each isolated in a `<bdi>` and
 * joined with the reader's comma ("،" in Arabic). A plain ", "-join let a
 * Latin name pull its neighbours and the commas out of order in an Arabic
 * row (ETQAN-QA-170), and a hard-coded "،" showed in English. */
export function NameList({ names }: { names: readonly string[] }) {
	const { i18n } = useTranslation();
	if (names.length === 0) return <>—</>;
	const comma = RTL_LOCALES.includes(i18n.language as Locale) ? "، " : ", ";
	return (
		<>
			{names.map((name, index) => (
				// biome-ignore lint/suspicious/noArrayIndexKey: two people may share a name
				<Fragment key={index}>
					{index > 0 ? comma : null}
					<bdi>{name}</bdi>
				</Fragment>
			))}
		</>
	);
}
